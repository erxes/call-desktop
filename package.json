{
  "name": "call-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "erxes calls as a desktop phone for macOS, Windows and Linux",
  "homepage": "https://erxes.io",
  "author": "erxes Inc <info@erxes.io>",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "vp pack && vp build",
    "dev": "pnpm build && env -u ELECTRON_RUN_AS_NODE electron .",
    "e2e": "pnpm build && env -u ELECTRON_RUN_AS_NODE playwright test -c e2e/playwright.config.ts",
    "dist": "pnpm build && electron-builder"
  },
  "devDependencies": {
    "@erxes/lint": "0.1.3",
    "@playwright/test": "^1.65.0",
    "@tabler/icons-react": "3.34.0",
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "jssip": "^3.13.9",
    "knip": "^6.45.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "build": {
    "appId": "io.erxes.call",
    "productName": "erxes Call",
    "files": [
      "dist"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "erxes",
      "repo": "call-desktop",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        },
        {
          "target": "zip",
          "arch": "universal"
        }
      ],
      "artifactName": "erxes-Call-mac.${ext}",
      "hardenedRuntime": true,
      "entitlements": "static/entitlements.mac.plist",
      "entitlementsInherit": "static/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "erxes uses the microphone for calls."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "erxes-Call-windows.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "erxes-Call-linux.${ext}",
      "category": "Office"
    }
  }
}
